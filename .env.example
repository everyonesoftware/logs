LOGS_VERSION=0.1.11
# This tag predates the rename. Remove this override when selecting a tag from the new package.
LOGS_IMAGE=ghcr.io/everyonesoftware/logs-web
# For a live-ingestion build, set a private token (openssl rand -hex 32).
LOGS_INGEST_TOKEN=
# Optional: enable Settings key management with a separate administrator token (openssl rand -hex 32).
LOGS_ADMIN_TOKEN=
# Optional: exact hostname of an access-controlled HTTPS proxy (no scheme or port).
LOGS_ALLOWED_HOST=
