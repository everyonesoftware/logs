<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="LogsBackground" Color="#101212" />
          <SolidColorBrush x:Key="LogsPanel" Color="#151818" />
          <SolidColorBrush x:Key="LogsLine" Color="#343D39" />
          <SolidColorBrush x:Key="LogsMuted" Color="#A5AFAA" />
          <SolidColorBrush x:Key="LogsAccent" Color="#A8E5BD" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="LogsBackground" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="LogsPanel" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="LogsLine" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="LogsMuted" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="LogsAccent" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LogsPanel}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LogsLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
      </Style>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border Grid.RowSpan="2" Background="{ThemeResource LogsBackground}" IsHitTestVisible="False" />
  <Border x:Name="TitleBar" Background="{ThemeResource LogsPanel}">
    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Spacing="10" VerticalAlignment="Center">
      <PathIcon Data="M 0,8 L 5,8 L 8,3 L 12,13 L 15,8 L 20,8 L 20,10 L 16,10 L 12,17 L 8,7 L 6,10 L 0,10 Z" Foreground="{ThemeResource LogsAccent}" Width="20" Height="18" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock Text="Logs" FontWeight="SemiBold" />
    </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24,20,24,24" Spacing="14" MaxWidth="1540">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock x:Name="PageHeading" Text="Investigate" FontSize="32" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Name="PageCaption" Text="Search across apps. Check the metric without leaving the results." Foreground="{ThemeResource LogsMuted}" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings" VerticalAlignment="Top" />
      </Grid>
      <StackPanel x:Name="Workspace" Spacing="12">
        <TextBlock x:Name="SampleLabel" Foreground="{ThemeResource LogsAccent}" TextWrapping="Wrap" FontSize="12" />
        <TextBox x:Name="SearchBox" PlaceholderText="Search messages, request IDs, or source" AutomationProperties.Name="Search logs" />
        <Grid x:Name="Toolbar" ColumnSpacing="10" RowSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ComboBox x:Name="AppFilter" HorizontalAlignment="Stretch" AutomationProperties.Name="Application" />
          <ComboBox x:Name="LevelFilter" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Severity" />
          <ComboBox x:Name="RangeFilter" Grid.Row="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Time range" />
          <Button x:Name="ResetButton" Grid.Row="1" Grid.Column="1" Content="Reset filters" HorizontalAlignment="Right" />
        </Grid>
        <Border x:Name="Scope" Style="{StaticResource Card}" Padding="12,8" Visibility="Collapsed">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ScopeText" Foreground="{ThemeResource LogsAccent}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="ClearScopeButton" Grid.Column="1" Content="Clear window" />
          </Grid>
        </Border>
        <Grid x:Name="Work" ColumnSpacing="14" RowSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border x:Name="LogsCard" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="14">
            <Grid RowSpacing="10">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Logs" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="ResultCount" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource LogsAccent}" AutomationProperties.LiveSetting="Polite" />
              </Grid>
              <TextBlock Grid.Row="1" Text="Newest first · UTC" FontSize="12" Foreground="{ThemeResource LogsMuted}" />
              <ListView x:Name="EventsList" Grid.Row="2" MaxHeight="418" SelectionMode="Single" Padding="0,0,8,0" AutomationProperties.Name="Log results" />
              <TextBlock x:Name="NoResults" Grid.Row="2" Text="No events match. Try a broader time range or clear a filter." TextWrapping="Wrap" Visibility="Collapsed" />
            </Grid>
          </Border>
          <StackPanel x:Name="Side" Grid.Row="1" Spacing="14">
            <Border Style="{StaticResource Card}" Padding="14">
              <StackPanel Spacing="10">
                <TextBlock Text="Metric timeline" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="MetricLabel" Foreground="{ThemeResource LogsMuted}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="MetricValue" FontSize="24" FontWeight="SemiBold" />
                  <TextBlock x:Name="PeakLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource LogsAccent}" />
                </Grid>
                <Canvas x:Name="Timeline" Height="120" Background="{ThemeResource LogsPanel}">
                  <Path x:Name="TimelineGrid" Stroke="{ThemeResource LogsLine}" IsHitTestVisible="False" />
                  <Path x:Name="TimelineLine" Stroke="{ThemeResource LogsAccent}" StrokeThickness="2" IsHitTestVisible="False" />
                  <Button x:Name="PeakPoint" Width="32" Height="32" Padding="0" Content="↘" />
                </Canvas>
                <Grid>
                  <TextBlock x:Name="AxisStart" FontSize="12" Foreground="{ThemeResource LogsMuted}" />
                  <TextBlock x:Name="AxisEnd" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource LogsMuted}" />
                </Grid>
                <Button x:Name="JumpButton" HorizontalAlignment="Stretch"><TextBlock x:Name="JumpLabel" TextWrapping="Wrap" /></Button>
                <TextBlock x:Name="NoPeak" Text="No incident spike in this window." Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource LogsMuted}" />
              </StackPanel>
            </Border>
            <Border x:Name="Details" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
              <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Event details" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                  <Button x:Name="CloseDetailsButton" Grid.Column="1" Content="×" AutomationProperties.Name="Close event details" />
                </Grid>
                <TextBlock x:Name="DetailMessage" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="DetailFields" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        <TextBlock Text="/ Focus search  ·  Esc Close event" Foreground="{ThemeResource LogsMuted}" FontSize="12" />
      </StackPanel>
      <Border x:Name="Settings" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed">
        <StackPanel Spacing="8">
          <TextBlock x:Name="VersionLabel" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="Updates unavailable" FontWeight="SemiBold" />
          <TextBlock Text="No Windows update feed is configured for this build." TextWrapping="Wrap" Foreground="{ThemeResource LogsMuted}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
